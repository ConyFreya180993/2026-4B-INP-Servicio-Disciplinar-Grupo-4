        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam backgroundColor white\nskinparam defaultFontColor #1F2937\nskinparam defaultFontSize 14\nskinparam ArrowFontSize 12\nskinparam titleFontSize 16\nskinparam nodesep 35\nskinparam ranksep 35\nskinparam shadowing false\nskinparam componentStyle uml2\nskinparam packageStyle rectangle\nskinparam nodesep 60\nskinparam ranksep 60\n\ntitle Diagrama UML de Despliegue y Componentes — Peluditos Pet Chile (Entrega 2)\n\nlegend top right\n  | Color | Estado al Cierre de Entrega 2 |\n  | &lt;#DCFCE7&gt; | Implementado e Integrado |\n  | &lt;#FED7AA&gt; | Implementación Parcial / Pruebas Locales |\n  | &lt;#DBEAFE&gt; | Persistencia Relacional (MariaDB) |\n  | &lt;#FEF9C3&gt; | Planificado para Entrega 3 |\nendlegend\n\n&#39; NOTA PARA CONSTANZA: Si el domingo un componente queda a medias,\n&#39; solo cambia su #DCFCE7 por #FED7AA (Parcial) o #FEF9C3 (Planificado E3).\n\nnode \&quot;«device»\\nNodo Cliente (Navegador Web)\&quot; as ClientNode {\n  component \&quot;«component»\\nBandeja de Tareas Web\\n(Proyecto-3-WebApp: Prototipo/HTML)\&quot; as WebApp #DCFCE7\n  component \&quot;«component»\\nDashboard de Métricas\\n[Planificado Entrega 3]\&quot; as Dashboard #FEF9C3\n}\n\nnode \&quot;«executionEnvironment»\\nEntorno Flowable OSS v7.2\&quot; as FlowableNode {\n  interface \&quot;Flowable REST API\&quot; as IFlowableREST\n  component \&quot;«component»\\nMotor BPMN Flowable OSS 7.2\\n(TO-BE Leads + TO-BE Fidelización)\&quot; as FlowableEngine #DCFCE7\n  IFlowableREST - [FlowableEngine]\n}\n\nnode \&quot;«executionEnvironment»\\nEntorno Java 21 (Workers)\&quot; as WorkerNode {\n  component \&quot;«component»\\nExternal Worker Java\\n(Proyecto-2-ExternalWorker)\\nTópicos: registrar-lead,\\nregistrar-resultado-lead,\\nprocesar-fidelizacion\&quot; as ExtWorker #DCFCE7\n  component \&quot;«component»\\nWorker Notificaciones\\n(WhatsApp/Correo)\\n[Planificado Entrega 3]\&quot; as NotifWorker #FEF9C3\n}\n\nnode \&quot;«executionEnvironment»\\nServidor Jakarta EE / Grizzly (Puerto 8080)\&quot; as BackendNode {\n  interface \&quot;API REST Negocio\&quot; as IBusinessREST\n  component \&quot;«component»\\nServicio Web Peluditos\\n(Proyecto-1-WebServices)\\nJakarta RESTful WS (Jersey)\&quot; as BusinessWS #DCFCE7\n  IBusinessREST - [BusinessWS]\n}\n\nnode \&quot;«device»\\nServidor MariaDB (Puerto 3306)\&quot; as DBNode {\n  database \&quot;«database»\\nflowable_db\\n(Motor BPMN)\&quot; as FlowableDB #DBEAFE\n  database \&quot;«database»\\npeluditos_db\\n(Negocio: leads,\\nseguimientos, fidelizacion)\&quot; as BusinessDB #DBEAFE\n}\n\nWebApp --&gt; IFlowableREST : \&quot;1. HTTP/JSON\\n(Instancias y Tareas)\&quot;\nWebApp --&gt; IBusinessREST : \&quot;2. HTTP/JSON\\n(Bandeja)\&quot;\nExtWorker --&gt; IFlowableREST : \&quot;3. HTTP Polling\\n(External Jobs)\&quot;\nExtWorker --&gt; IBusinessREST : \&quot;4. HTTP/JSON\\n(POST / PUT Negocio)\&quot;\nNotifWorker ..&gt; IFlowableREST : \&quot;Futuro Polling (E3)\&quot;\nFlowableEngine --&gt; FlowableDB : \&quot;5. JDBC (Estado BPMN)\&quot;\nBusinessWS --&gt; BusinessDB : \&quot;6. JDBC (CRUD Negocio)\&quot;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mugNbo0gOWfylsKgJvaC-1">
